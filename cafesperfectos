<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>El Código Barista | Recetario de Cafetería de Especialidad en Casa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-cream: #FAF7F2;
      --bg-white: #FFFFFF;
      --espresso: #1E1611;
      --espresso-soft: #2E221B;
      --caramel: #C27D38;
      --caramel-hover: #A86829;
      --text-main: #2B211B;
      --text-muted: #66584F;
      --border-soft: #E8DFD3;
      --radius: 14px;
      --shadow-sm: 0 6px 20px rgba(30, 22, 17, 0.05);
      --shadow-lg: 0 18px 40px rgba(30, 22, 17, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-cream);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .serif {
      font-family: 'Playfair Display', serif;
      line-height: 1.2;
      color: var(--espresso);
    }

    .container {
      width: 100%;
      max-width: 1060px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Botón Principal */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background-color: var(--caramel);
      color: #FFFFFF;
      font-weight: 700;
      font-size: 1.05rem;
      text-decoration: none;
      padding: 18px 34px;
      border-radius: 50px;
      box-shadow: 0 10px 25px rgba(194, 125, 56, 0.35);
      transition: all 0.25s ease;
      text-align: center;
      cursor: pointer;
    }

    .btn:hover {
      background-color: var(--caramel-hover);
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(194, 125, 56, 0.45);
    }

    .btn-full {
      width: 100%;
      max-width: 460px;
    }

    .micro-note {
      display: block;
      margin-top: 10px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Barra superior sutil */
    .top-bar {
      background-color: var(--espresso);
      color: #EFE6DA;
      text-align: center;
      font-size: 0.85rem;
      padding: 10px 16px;
      letter-spacing: 0.3px;
    }

    .top-bar span {
      color: #E5A967;
      font-weight: 600;
    }

    /* Hero Section */
    .hero {
      padding: 72px 0 84px;
      background: linear-gradient(180deg, #F4EDE3 0%, var(--bg-cream) 100%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: center;
    }

    .eyebrow {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--caramel);
      margin-bottom: 14px;
    }

    .hero h1 {
      font-size: clamp(2.1rem, 4vw, 3.1rem);
      margin-bottom: 20px;
    }

    .hero p.lead {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 26px;
    }

    .hero-list {
      list-style: none;
      margin-bottom: 32px;
    }

    .hero-list li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 10px;
      font-weight: 500;
    }

    .hero-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 0;
      color: var(--caramel);
      font-weight: 700;
    }

    .hero-image-wrap {
      position: relative;
    }

    .hero-image-wrap img {
      width: 100%;
      height: 490px;
      object-fit: cover;
      border-radius: 22px;
      box-shadow: var(--shadow-lg);
      display: block;
    }

    .floating-badge {
      position: absolute;
      bottom: -18px;
      left: 24px;
      background: var(--bg-white);
      padding: 14px 20px;
      border-radius: 14px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-soft);
      font-size: 0.9rem;
    }

    .floating-badge strong {
      display: block;
      color: var(--espresso);
    }

    /* Secciones generales */
    section {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 52px;
    }

    .section-header h2 {
      font-size: clamp(1.8rem, 3.2vw, 2.5rem);
      margin-bottom: 14px;
    }

    .section-header p {
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    /* Problema / Solución */
    .story-section {
      background-color: var(--bg-white);
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
    }

    .story-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 48px;
      align-items: center;
    }

    .story-grid img {
      width: 100%;
      height: 420px;
      object-fit: cover;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }

    .pain-list {
      list-style: none;
      margin: 22px 0;
    }

    .pain-list li {
      padding: 10px 0 10px 28px;
      position: relative;
      color: var(--text-muted);
      border-bottom: 1px solid #F3ECE2;
    }

    .pain-list li::before {
      content: "✕";
      position: absolute;
      left: 0;
      color: #B8523B;
      font-weight: 700;
    }

    .secret-box {
      background-color: var(--bg-cream);
      border-left: 4px solid var(--caramel);
      padding: 18px 22px;
      border-radius: 0 12px 12px 0;
      margin-top: 22px;
      font-size: 0.98rem;
    }

    /* Contenido del Recetario */
    .modules-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .module-card {
      background: var(--bg-white);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: var(--shadow-sm);
    }

    .module-tag {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--caramel);
      margin-bottom: 8px;
      display: block;
    }

    .module-card h3 {
      font-size: 1.35rem;
      margin-bottom: 14px;
    }

    .module-card ul {
      list-style: none;
    }

    .module-card ul li {
      position: relative;
      padding-left: 20px;
      margin-bottom: 10px;
      font-size: 0.96rem;
      color: var(--text-muted);
    }

    .module-card ul li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--caramel);
      font-weight: bold;
      font-size: 1.2rem;
      line-height: 1.2;
    }

    /* Destacado visual de bebidas frías */
    .showcase-banner {
      margin-top: 40px;
      background-color: var(--espresso);
      color: #FAF7F2;
      border-radius: 18px;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }

    .showcase-text {
      padding: 40px;
    }

    .showcase-text h3 {
      color: #FFFFFF;
      font-size: 1.65rem;
      margin-bottom: 12px;
    }

    .showcase-text p {
      color: #D8CEC2;
      font-size: 0.98rem;
    }

    .showcase-banner img {
      width: 100%;
      height: 100%;
      min-height: 260px;
      object-fit: cover;
      display: block;
    }

    /* Bonos */
    .bonuses-section {
      background-color: var(--bg-white);
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
    }

    .bonus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .bonus-card {
      background: var(--bg-cream);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .bonus-badge {
      display: inline-block;
      background: rgba(194, 125, 56, 0.14);
      color: var(--caramel-hover);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 50px;
      margin-bottom: 14px;
      width: fit-content;
    }

    .bonus-card h3 {
      font-size: 1.22rem;
      margin-bottom: 10px;
    }

    .bonus-card p {
      font-size: 0.94rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .bonus-value {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--espresso);
    }

    .bonus-value span {
      text-decoration: line-through;
      color: var(--text-muted);
      margin-right: 6px;
    }

    /* Testimonios */
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .review-card {
      background: var(--bg-white);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow-sm);
    }

    .stars {
      color: #D99B26;
      letter-spacing: 2px;
      margin-bottom: 12px;
      font-size: 1rem;
    }

    .review-card p {
      font-size: 0.95rem;
      color: var(--text-main);
      font-style: italic;
      margin-bottom: 16px;
    }

    .reviewer {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--espresso);
    }

    /* Caja de Oferta */
    .offer-section {
      background: linear-gradient(180deg, var(--bg-cream) 0%, #EFE6D8 100%);
    }

    .offer-box {
      max-width: 720px;
      margin: 0 auto;
      background: var(--bg-white);
      border: 2px solid var(--caramel);
      border-radius: 22px;
      padding: 48px 40px;
      box-shadow: var(--shadow-lg);
      text-align: center;
    }

    .stack-list {
      list-style: none;
      text-align: left;
      max-width: 540px;
      margin: 28px auto;
      border-top: 1px solid var(--border-soft);
    }

    .stack-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 0.96rem;
      gap: 12px;
    }

    .stack-list li span.price-tag {
      color: var(--text-muted);
      text-decoration: line-through;
      white-space: nowrap;
    }

    .price-block {
      margin: 28px 0;
    }

    .old-price {
      font-size: 1.05rem;
      color: var(--text-muted);
    }

    .old-price span {
      text-decoration: line-through;
    }

    .current-price {
      font-family: 'Playfair Display', serif;
      font-size: 3.2rem;
      font-weight: 700;
      color: var(--espresso);
      line-height: 1.1;
      margin: 6px 0;
    }

    .guarantee-box {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px dashed var(--border-soft);
      font-size: 0.92rem;
      color: var(--text-muted);
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .guarantee-box strong {
      color: var(--espresso);
      display: block;
      margin-bottom: 4px;
      font-size: 1rem;
    }

    /* FAQ */
    .faq-list {
      max-width: 740px;
      margin: 0 auto;
    }

    details {
      background: var(--bg-white);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      margin-bottom: 14px;
      padding: 18px 24px;
    }

    summary {
      font-weight: 700;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--espresso);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::after {
      content: "+";
      font-size: 1.3rem;
      color: var(--caramel);
      font-weight: 700;
    }

    details[open] summary::after {
      content: "−";
    }

    details p {
      margin-top: 12px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Footer */
    footer {
      background-color: var(--espresso);
      color: #B8ACA0;
      text-align: center;
      padding: 36px 20px;
      font-size: 0.85rem;
    }

    /* Responsive */
    @media (max-width: 860px) {
      .hero-grid,
      .story-grid,
      .modules-grid,
      .bonus-grid,
      .reviews-grid,
      .showcase-banner {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 48px 0 64px;
      }

      .hero-image-wrap img {
        height: 360px;
      }

      .offer-box {
        padding: 36px 22px;
      }
    }
  </style>
</head>
<body>

  <!-- Barra superior -->
  <div class="top-bar">
    Descarga Digital Inmediata • <span>Incluye 3 Guías de Regalo por Lanzamiento</span>
  </div>

  <!-- HERO -->
  <header class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Edición Digital • Barra de Café en Casa</span>
        <h1>Prepara Bebidas de Barista Irresistibles en Menos de 5 Minutos</h1>
        <p class="lead">
